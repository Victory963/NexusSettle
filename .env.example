IDENTITY_API_URL=
CINEMA_API_URL=
CONTINUITY_API_URL=
DRIVE_API_URL=
# Fallback queue if the four product engines share one local worker:
# LOCAL_QUEUE_URL=http://127.0.0.1:8188

# A2A clearing. Start in demo; testnet rejects an in-memory database.
CLEARING_MODE=demo
CLEARING_MAINNET_ENABLED=false
DATABASE_URL=postgresql://lumen:lumen-local-only@127.0.0.1:5432/lumen
CLEARING_DB_SSL=false
CLEARING_DB_POOL_SIZE=10

# Seller and buyer KYA binding (testnet values only).
CLEARING_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000
CLEARING_AGENT_ID=agent-buyer-research
CLEARING_AGENT_WALLET=0x0000000000000000000000000000000000000000
AGENT_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Official x402 facilitators. Stable Testnet USDT0 needs a compatible facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_USDT_FACILITATOR_URL=
X402_FACILITATOR_TIMEOUT_MS=25000

# Coinbase Developer Platform / AgentKit buyer wallet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_WALLET_ADDRESS=
CDP_WALLET_IDEMPOTENCY_KEY=lumen-a2a-testnet-buyer

# Client guardrails and deployment URL.
CLEARING_MAX_PER_PAYMENT_ATOMIC=500000
LUMEN_CLEARING_URL=http://localhost:3000
RPC_URL=https://sepolia.base.org
STABLE_TESTNET_RPC_URL=
